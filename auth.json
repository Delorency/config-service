{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "jwt_secret": {
      "type": "string",
      "minLength": 32
    },
    "token_ttl": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400,
      "default": 3600
    },
    "refresh_ttl": {
      "type": "integer",
      "minimum": 3600,
      "maximum": 604800,
      "default": 86400
    },
    "session_store": {
      "type": "string",
      "enum": ["redis", "memory", "database"],
      "default": "redis"
    }
  },
  "required": ["jwt_secret"]
}
