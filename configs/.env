# HTTP Server Configuration
HTTPHOST=0.0.0.0
HTTPPORT=8080
HTTPSHUTDOWNTIMEOUT=30s

# GRPC Server Configuration
GRPCHOST=0.0.0.0
GRPCPORT=8081
GRPCSHUTDOWNTIMEOUT=30s

# Database Configuration
DB_ROLE=delorency
DB_PASS=delorency
