# HTTP Server Configuration
HTTPHOST=localhost
HTTPPORT=8080
HTTPSHUTDOWNTIMEOUT=30s

# GRPC Server Configuration
GRPCHOST=localhost
GRPCPORT=8081
GRPCSHUTDOWNTIMEOUT=30s

# Database Configuration
DB_ROLE=delorency
DB_PASS=delorency
DB_HOST=localhost
DB_PORT=5432
DB_NAME=configservice

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_USERNAME=default
REDIS_PASS=default
REDIS_DB=0

# RabbitMQ Configuration
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest
RABBIT_VHOST=/
RABBIT_EXCHANGE_NAME=config.updates
RABBIT_EXCHANGE_TYPE=fanout
RABBIT_QUEUE_PREFIX=config-service.

# Loggers Configuration
LOGSDIR=logs/ # папка с логами
APILOGFILENAME=api.log # название файла с логами для api
DBLOGFILENAME=db.log # название файла с логами обращений к бд

#Schema Configuration
SCHEMASDIR=schemas/