# Loggers Configuration
LOGSDIR=logs/ # папка с логами
APILOGFILENAME=api.log # название файла с логами для api
GRPCLOGFILENAME=grpc.log # название файла с логами обращений к бд
DBLOGFILENAME=db.log # название файла с логами обращений к бд

#Schema Configuration
SCHEMASDIR=schemas/